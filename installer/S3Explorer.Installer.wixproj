<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerOutputName Condition="'$(InstallerOutputName)' == ''">S3Explorer-v$(Version)-win-x64-setup</InstallerOutputName>
    <InstallerFlavor Condition="'$(InstallerFlavor)' == ''">self-contained</InstallerFlavor>
    <OutputName>$(InstallerOutputName)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>zh-CN</Cultures>
    <DebugType>None</DebugType>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
    <ApplicationIconPath>$(MSBuildThisFileDirectory)..\src\S3Explorer.App\Assets\S3Explorer.ico</ApplicationIconPath>
    <DefineConstants>$(DefineConstants);ProductVersion=$(Version);PayloadDir=$(PayloadDir);ApplicationIconPath=$(ApplicationIconPath);InstallerFlavor=$(InstallerFlavor)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
  </ItemGroup>
</Project>
